# TMDB 설정 > API > API Read Access Token (API 읽기 액세스 토큰)
# https://www.themoviedb.org/settings/api
# 토큰 값만 입력합니다. Bearer 접두사를 붙이지 않습니다.
# 서버 전용 값이므로 NEXT_PUBLIC_ 접두사를 사용하지 않습니다.
TMDB_READ_ACCESS_TOKEN=

# Supabase 프로젝트 설정 > API: Project URL 및 publishable key
# 브라우저에 공개되는 값입니다. secret / service_role 키는 넣지 않습니다.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# 서버 전용: 프로필 사진 Storage 업로드·삭제에 사용. 절대 NEXT_PUBLIC_ 접두사를 붙이지 않습니다.
SUPABASE_SECRET_KEY=

# 서버 전용: Supabase > Connect > Session pooler의 PostgreSQL URI
# [YOUR-PASSWORD]를 DB 비밀번호(URL 인코딩)로 바꾸고 ?sslmode=verify-full 추가
# 두 개발자 모두 같은 개발 프로젝트에 연결합니다. Git에는 올리지 않습니다.
DATABASE_URL=
# 별도 마이그레이션 연결이 없다면 비워 둡니다. DATABASE_URL을 사용합니다.
DATABASE_MIGRATION_URL=

# Supabase에서 Google 제공자를 활성화한 경우에만 true
NEXT_PUBLIC_SUPABASE_GOOGLE_ENABLED=false
